{
  "name": "@fx/tx",
  "version": "1.2.0",
  "description": "Extensible command-line toolbox",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fx/tx.git"
  },
  "homepage": "https://github.com/fx/tx#readme",
  "bugs": {
    "url": "https://github.com/fx/tx/issues"
  },
  "bin": {
    "tx": "./dist/tx"
  },
  "exports": {
    "./plugin": {
      "types": "./src/plugin.ts"
    }
  },
  "files": [
    "dist/tx",
    "src/plugin.ts",
    "src/context.ts",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc",
    "test": "bun test",
    "build": "bun build.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "commander": "15.0.0",
    "ink": "7.1.1",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1"
  }
}
